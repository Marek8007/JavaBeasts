# Backend database configuration
# Use one of the two setups below by filling the active block into your real .env file.

# Local MySQL via Docker
DB_HOST=localhost
DB_PORT=33006
DB_NAME=JavaBeasts
DB_USERNAME=dbuser
DB_PASSWORD=change_me_db_password
DB_URL_OPTIONS='?sslMode=DISABLED'

# TiDB Cloud example
# DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=javaBeasts
# DB_USERNAME=your_tidb_username
# DB_PASSWORD=your_tidb_password
# DB_URL_OPTIONS='?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3'
