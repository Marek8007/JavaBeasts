# Backend connected to TiDB Cloud or another external MySQL-compatible DB.
# This file intentionally contains placeholders only.

DB_HOST=your-cloud-database-host.example.com
DB_PORT=4000
DB_NAME=JavaBeasts
DB_USERNAME=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_URL_OPTIONS=?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3

BACKEND_HTTP_PORT=9234
BACKEND_SOCKET_PORT=7878

# JavaFX connects through Docker network
JAVABEASTS_LOBBY_HOST=backend
JAVABEASTS_LOBBY_PORT=7878
